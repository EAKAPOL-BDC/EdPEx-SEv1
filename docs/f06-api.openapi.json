  "components": {
    "schemas": {
      "Answer": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "answered",
              "missing",
              "skipped",
              "not_applicable",
              "unable_to_assess",
              "not_shown"
            ]
          },
          "value": {
            "type": [
              "integer",
              "string"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 1000
          },
          "example": {
            "type": "string",
            "maxLength": 4000
          },
          "development_plan": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "description": "Published F06 IDs only. Score values are integers 1–5. Non-score states have no value. M/T NA requires a reason. not_shown is server-owned; omitted duties become not_shown. Context fields P01–P05 cannot be supplied. Examples/plans accompany score questions only."
      },
      "RevisionWrite": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Answer"
            }
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "expected_revision",
          "answers",
          "idempotency_key"
        ],
        "additionalProperties": false
      },
      "RevisionReceipt": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "draft",
              "submitted"
            ]
          },
          "completeness": {
            "enum": [
              "complete",
              "partial"
            ]
          },
          "reused": {
            "type": "boolean"
          }
        },
        "required": [
          "revision",
          "status",
          "completeness",
          "reused"
        ],
        "additionalProperties": false
      },
      "AssignmentWrite": {
        "type": "object",
        "properties": {
          "round_instrument_id": {
            "type": "string",
            "format": "uuid"
          },
          "member_id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "integer",
            "minimum": 1
          },
          "duties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "expected_levels": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "applicable_question_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "round_instrument_id",
          "member_id",
          "user_id",
          "duties",
          "expected_levels",
          "applicable_question_ids"
        ],
        "additionalProperties": false
      },
      "CalculationWrite": {
        "type": "object",
        "properties": {
          "cutoff": {
            "type": "string",
            "format": "date-time"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "dry_run": {
            "type": "boolean"
          }
        },
        "required": [
          "cutoff",
          "idempotency_key",
          "dry_run"
        ],
        "additionalProperties": false
      },
      "CalculationReceipt": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "input_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "result_count": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "dry_run",
              "complete"
            ]
          },
          "reused": {
            "type": "boolean"
          }
        },
        "required": [
          "run_id",
          "input_hash",
          "result_count",
          "status",
          "reused"
        ],
        "additionalProperties": false
      },
      "ReviewWrite": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      },
      "ReviewReceipt": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "review",
              "approved",
              "returned"
            ]
          },
          "review_token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reused": {
            "type": "boolean"
          }
        },
        "required": [
          "run_id",
          "status",
          "review_token",
          "reused"
        ],
        "additionalProperties": false
      },
      "DecisionWrite": {
        "type": "object",
        "properties": {
          "outcome": {
            "enum": [
              "approved",
              "returned"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "reviewed_token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "outcome",
          "reason",
          "reviewed_token"
        ],
        "additionalProperties": false
      },
      "DecisionReceipt": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "approved",
              "returned"
            ]
          },
          "publication_status": {
            "const": "unpublished"
          },
          "reused": {
            "type": "boolean"
          }
        },
        "required": [
          "run_id",
          "status",
          "publication_status",
          "reused"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "enum": [
              "authentication_required",
              "forbidden",
              "not_found",
              "revision_or_request_conflict",
              "invalid_request"
            ]
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "OwnerSchema": {
        "type": "object",
        "properties": {
          "assignment_id": {
            "type": "string",
            "format": "uuid"
          },
          "instrument_version": {
            "type": "string"
          },
          "round": {
            "type": "string"
          },
          "group": {
            "enum": [
              "ST1",
              "ST2"
            ]
          },
          "duties": {
            "type": "string"
          },
          "method": {
            "const": "self_report"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "integer_scale",
                    "single_choice",
                    "text"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "value": {
                        "type": [
                          "integer",
                          "string"
                        ]
                      }
                    },
                    "required": [
                      "code",
                      "label",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                },
                "expected_level": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "allow_na": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "type",
                "text",
                "options",
                "expected_level",
                "allow_na"
              ],
              "additionalProperties": false
            }
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "editable": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "not_started",
              "draft",
              "submitted"
            ]
          },
          "completeness": {
            "enum": [
              "complete",
              "partial"
            ]
          },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Answer"
            }
          }
        },
        "required": [
          "assignment_id",
          "instrument_version",
          "round",
          "group",
          "duties",
          "method",
          "questions",
          "instructions",
          "editable",
          "revision",
          "status",
          "completeness",
          "answers"
        ],
        "additionalProperties": false
      },
      "ReviewPacket": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "review",
              "approved",
              "returned"
            ]
          },
          "review_token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Fixed indicator/group/dimension, self_report method, formula spec and unit. Suppressed rows contain status/reason and omit value, numerator, denominator and quality_counts. Computed rows add those numeric fields as decimal strings and quality_counts. No source identities or raw answers."
            }
          },
          "publication_status": {
            "const": "unpublished"
          },
          "review_scope": {
            "const": "aggregate_formula_and_data_completeness"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "status",
          "review_token",
          "results",
          "publication_status",
          "review_scope",
          "reason"
        ],
        "additionalProperties": false
      },
      "AssignmentList": {
        "type": "object",
        "properties": {
          "assignments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "round": {
                  "type": "string"
                },
                "instrument_version": {
                  "type": "string"
                },
                "method": {
                  "const": "self_report"
                }
              },
              "required": [
                "id",
                "round",
                "instrument_version",
                "method"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "assignments"
        ],
        "additionalProperties": false
      },
      "AssignmentReceipt": {
        "type": "object",
        "properties": {
          "assignment_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "assignment_id"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRFToken",
        "description": "Obtain CSRF cookie from authenticated owner form; send matching token on unsafe methods."
      }
    }
  }
}
